<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.web.WebView?>

<!--
  Epubra 主界面：VSCode 风格布局。

    top    MenuBar（命令全部走菜单 + 快捷键，已移除工具栏）
    left   活动栏（48px）：目录 / 资源 / 元数据 / 校验，四个 ToggleButton 共用一个 ToggleGroup
    center 侧边栏（单视图切换）| 编辑区（源码 / 预览）+ 底部「问题」面板，底下挂隐藏式查找条
    bottom 状态栏：左侧提示语，右侧错误 / 警告 / 章节 / 字数 / 主题

  侧边栏三个视图、查找条与底部问题面板各拆为独立 FXML，经 <fx:include> 引入：
  include 的 fx:id 决定父控制器的两个字段——根节点（如 tocView: VBox）与子控制器
  （如 tocViewController: TocController，命名规则 <fx:id>Controller）。
  子控制器由 FXML 实例化，BookContext 与回调在 MainController.initialize() 统一 bind。

  活动栏图标用 SVGPath（16×16 视口）绘制，颜色走 -epubra-* 变量，三套主题自动换色。
-->
<BorderPane xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.chobit.epubra.app.controller.MainController"
            stylesheets="@../css/app.css">

    <top>
        <MenuBar>
            <menus>
                <Menu text="文件">
                    <items>
                        <MenuItem text="新建" onAction="#onNew" accelerator="Ctrl+N"/>
                        <MenuItem text="打开…" onAction="#onOpen" accelerator="Ctrl+O"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="打开工作空间…" onAction="#onOpenWorkspace"/>
                        <Menu fx:id="recentWorkspaceMenu" text="打开最近工作空间"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="保存" onAction="#onSave" accelerator="Ctrl+S"/>
                        <MenuItem text="另存为…" onAction="#onSaveAs" accelerator="Ctrl+Shift+S"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="退出" onAction="#onExit"/>
                    </items>
                </Menu>
                <Menu fx:id="editMenu" text="编辑">
                    <items>
                        <MenuItem fx:id="undoItem" text="撤销" onAction="#onUndo" accelerator="Ctrl+Z"/>
                        <MenuItem fx:id="redoItem" text="重做" onAction="#onRedo" accelerator="Ctrl+Shift+Z"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="查找替换…" onAction="#onShowFind" accelerator="Ctrl+F"/>
                    </items>
                </Menu>
                <!-- 原「开始」。章节是结构操作而非格式化操作，放「开始」不符合常规心智；
                     「重命名章节…」也从「编辑」归并过来，让章节相关操作集中一处。 -->
                <Menu fx:id="chapterMenu" text="章节">
                    <items>
                        <MenuItem text="添加章节" onAction="#onAddChapter"/>
                        <MenuItem text="重命名章节…" onAction="#onRenameChapter" accelerator="F2"/>
                        <MenuItem text="删除章节" onAction="#onDeleteChapter"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="上移" onAction="#onMoveUp"/>
                        <MenuItem text="下移" onAction="#onMoveDown"/>
                        <SeparatorMenuItem/>
                        <!-- 层级调整与上移/下移同属「结构」组，菜单与目录树右键保持一致，
                             避免「右键有、菜单没有」。这两项在菜单里不灰化：可用性取决于
                             选中节点的层级（顶层不能升级、同级首项不能降级），点击后由
                             TocController.changeLevel 给出状态提示，与上移/下移的容错方式一致。 -->
                        <MenuItem text="降一级" onAction="#onIndentChapter"/>
                        <MenuItem text="升一级" onAction="#onOutdentChapter"/>
                    </items>
                </Menu>
                <Menu fx:id="insertMenu" text="插入">
                    <items>
                        <MenuItem text="导入资源…" onAction="#onImportResources"/>
                        <MenuItem text="插入图片" onAction="#onInsertImage"/>
                    </items>
                </Menu>
                <!-- 「刷新预览 / 并排预览」是**有书才有意义**的命令：首页（书架）由
                     EditorShellActivity 连同两条分隔线一起收起，只留主题三项，见该类 javadoc。 -->
                <Menu text="视图">
                    <items>
                        <MenuItem fx:id="refreshPreviewItem" text="刷新预览" onAction="#onRefreshPreview"/>
                        <SeparatorMenuItem fx:id="previewSeparatorTop"/>
                        <MenuItem fx:id="splitPreviewItem" text="并排预览" onAction="#onToggleSplitPreview"/>
                        <SeparatorMenuItem fx:id="previewSeparatorBottom"/>
                        <RadioMenuItem fx:id="themeLightItem" text="浅色" onAction="#onThemeLight"
                                       selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="themeGroup"/>
                            </toggleGroup>
                        </RadioMenuItem>
                        <RadioMenuItem fx:id="themeDarkItem" text="深色" onAction="#onThemeDark"
                                       toggleGroup="$themeGroup"/>
                        <RadioMenuItem fx:id="themeSepiaItem" text="护眼米黄" onAction="#onThemeSepia"
                                       toggleGroup="$themeGroup"/>
                    </items>
                </Menu>
                <!-- 「清理未引用资源」不是插入动作，「运行校验」是工具性操作而非视图开关，
                     两者从原「插入」「视图」里分出来单独立项。 -->
                <Menu fx:id="toolsMenu" text="工具">
                    <items>
                        <MenuItem text="运行校验" onAction="#onRunValidation"/>
                        <MenuItem text="清理未引用资源" onAction="#onCleanupResources"/>
                    </items>
                </Menu>
                <Menu text="帮助">
                    <items>
                        <MenuItem text="关于" onAction="#onAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <VBox fx:id="activityBar" styleClass="activity-bar" prefWidth="48.0" minWidth="48.0" maxWidth="48.0"
              spacing="2.0">
            <padding>
                <Insets top="6.0" right="0.0" bottom="6.0" left="0.0"/>
            </padding>

            <ToggleButton fx:id="tocActivityButton" styleClass="activity-button" selected="true"
                          contentDisplay="GRAPHIC_ONLY"
                          onAction="#onShowTocView">
                <toggleGroup>
                    <ToggleGroup fx:id="activityGroup"/>
                </toggleGroup>
                <graphic>
                    <!-- 书页 + 三行正文 -->
                    <SVGPath styleClass="activity-icon" fillRule="EVEN_ODD"
                             content="M 3.5 2.5 h 6 l 2 2 v 9 h -8 z M 5.5 6.5 h 5 v 1 h -5 z M 5.5 8.5 h 5 v 1 h -5 z M 5.5 10.5 h 3 v 1 h -3 z"/>
                </graphic>
                <tooltip>
                    <Tooltip text="目录"/>
                </tooltip>
            </ToggleButton>

            <ToggleButton fx:id="resourceActivityButton" styleClass="activity-button"
                          contentDisplay="GRAPHIC_ONLY"
                          toggleGroup="$activityGroup" onAction="#onShowResourceView">
                <graphic>
                    <!-- 文件夹 -->
                    <SVGPath styleClass="activity-icon"
                             content="M 1.5 4 h 4.2 l 1.5 2 H 14 V 13 H 1.5 Z"/>
                </graphic>
                <tooltip>
                    <Tooltip text="资源"/>
                </tooltip>
            </ToggleButton>

            <ToggleButton fx:id="metadataActivityButton" styleClass="activity-button"
                          contentDisplay="GRAPHIC_ONLY"
                          toggleGroup="$activityGroup" onAction="#onShowMetadataView">
                <graphic>
                    <!-- 信息圆 -->
                    <SVGPath styleClass="activity-icon" fillRule="EVEN_ODD"
                             content="M 8 1.75 a 6.25 6.25 0 1 0 0 12.5 a 6.25 6.25 0 1 0 0 -12.5 z M 7.25 6.9 h 1.5 v 4.4 h -1.5 z M 7.25 4.1 h 1.5 v 1.6 h -1.5 z"/>
                </graphic>
                <tooltip>
                    <Tooltip text="元数据"/>
                </tooltip>
            </ToggleButton>

            <ToggleButton fx:id="validationActivityButton" styleClass="activity-button"
                          contentDisplay="GRAPHIC_ONLY"
                          toggleGroup="$activityGroup" onAction="#onShowProblems">
                <graphic>
                    <!-- 对勾圆 -->
                    <SVGPath styleClass="activity-icon" fillRule="EVEN_ODD"
                             content="M 8 1.75 a 6.25 6.25 0 1 0 0 12.5 a 6.25 6.25 0 1 0 0 -12.5 z M 11.2 5.6 L 7.1 10.1 L 5 8.2 L 5.9 7.2 L 7.1 8.4 L 10.3 4.7 Z"/>
                </graphic>
                <tooltip>
                    <Tooltip text="校验（显示问题面板并立即校验）"/>
                </tooltip>
            </ToggleButton>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="main-center">
            <children>
                <!-- 常规编辑面板：无图书时也保留，但被 welcome-page 覆盖 -->
                <VBox>
                    <SplitPane fx:id="mainSplit" dividerPositions="0.22" VBox.vgrow="ALWAYS">
                        <items>
                            <!-- 侧边栏：三个视图叠放，按活动栏切换 visible + managed。

                                 注意：收起侧栏时必须连**本容器**一起隐藏——只把内层三个视图
                                 设为不可见，SplitPane 的 item 0 仍占着 dividerPositions 的
                                 22%，编辑区不会伸展过去（2026-09-06 修复的布局 bug）。 -->
                            <StackPane fx:id="sidePanel" styleClass="side-panel">
                                <children>
                                    <fx:include fx:id="tocView" source="toc-view.fxml"/>
                                    <fx:include fx:id="resourceView" source="resource-view.fxml"/>
                                    <fx:include fx:id="metadataView" source="metadata-view.fxml"/>
                                </children>
                            </StackPane>

                            <!-- 编辑区：编辑 / 源码 / 预览 + 底部问题面板。

                     可视化编辑（visualEditorView）走 WebView + contenteditable，
                     不用 JavaFX 的 HTMLEditor——后者产 HTML 而非 XHTML。
                     两种呈现模式共用 contentArea 与 previewView 两个节点：
                       标签模式（默认）— 分别挂在 editorTabs 的对应 Tab 上
                       并排模式        — 一起挂进 splitPreviewPane 左右分栏
                     切换时把节点在两个父容器之间搬运——一个 Node 只能有一个 parent。 -->
                            <VBox maxWidth="Infinity" maxHeight="Infinity">
                                <StackPane VBox.vgrow="ALWAYS">
                                    <TabPane fx:id="editorTabs" tabClosingPolicy="UNAVAILABLE">
                                        <tabs>
                                            <Tab text="编辑">
                                                <!-- 「编辑」tab 自带格式化工具条，直接作用于可视化编辑器。
                                                     按钮用 id 标注格式名（与 window.epubraQuery() 的返回值对应），
                                                     MainController 据此把「当前生效的格式」点亮。
                                                     FlowPane 而非 HBox：窗口变窄时按钮换行而不是被挤没。
                                                     源码 tab 不提供这些按钮——手写标签本来就比按钮快。 -->
                                                <VBox maxWidth="Infinity" maxHeight="Infinity">
                                                    <FlowPane fx:id="editorToolbar" styleClass="editor-toolbar"
                                                              hgap="4.0" vgap="4.0" alignment="CENTER_LEFT">
                                                        <padding>
                                                            <Insets top="4.0" right="8.0" bottom="4.0" left="8.0"/>
                                                        </padding>
                                                        <Button id="paragraph" text="段落" styleClass="flat-button"
                                                                onAction="#onInsertParagraph"/>
                                                        <Button id="heading" text="标题" styleClass="flat-button"
                                                                onAction="#onInsertHeading"/>
                                                        <Button id="quote" text="引用" styleClass="flat-button"
                                                                onAction="#onInsertQuote"/>
                                                        <Button id="list" text="列表" styleClass="flat-button"
                                                                onAction="#onInsertList"/>
                                                        <Button id="ol" text="编号" styleClass="flat-button"
                                                                onAction="#onInsertOrderedList"/>
                                                        <Button id="rule" text="分隔线" styleClass="flat-button"
                                                                onAction="#onInsertRule"/>
                                                        <Button id="bold" text="加粗" styleClass="flat-button"
                                                                onAction="#onInsertBold"/>
                                                        <Button id="italic" text="斜体" styleClass="flat-button"
                                                                onAction="#onInsertItalic"/>
                                                        <Button id="underline" text="下划线" styleClass="flat-button"
                                                                onAction="#onInsertUnderline"/>
                                                        <Button id="strike" text="删除线" styleClass="flat-button"
                                                                onAction="#onInsertStrike"/>
                                                        <Button id="code" text="行内代码" styleClass="flat-button"
                                                                onAction="#onInsertCode"/>
                                                        <Button id="link" text="链接" styleClass="flat-button"
                                                                onAction="#onInsertLink"/>
                                                        <!-- 图片与菜单「插入 → 插入图片」同一个入口（从已导入资源里选），
                                                             不另插一个裸 img 标签，避免两种不一致的行为。
                                                             toolbar-action 样式类 = 动作按钮：它没有「当前光标处
                                                             格式已生效」的状态，updateToolbarState 会跳过它，
                                                             不会被错误地点亮。 -->
                                                        <Button id="image" text="图片"
                                                                styleClass="flat-button, toolbar-action"
                                                                onAction="#onInsertImageFromDisk"/>
                                                    </FlowPane>
                                                    <WebView fx:id="visualEditorView" VBox.vgrow="ALWAYS"/>
                                                </VBox>
                                            </Tab>
                                            <Tab text="源码">
                                                <TextArea fx:id="contentArea" styleClass="content-editor"
                                                          promptText="选择左侧章节后，在此编辑 XHTML 源码"/>
                                            </Tab>
                                            <Tab text="预览">
                                                <WebView fx:id="previewView"/>
                                            </Tab>
                                        </tabs>
                                    </TabPane>
                                    <SplitPane fx:id="splitPreviewPane" visible="false" managed="false"
                                               dividerPositions="0.5"/>
                                </StackPane>

                                <fx:include fx:id="bottomPanel" source="problems-panel.fxml"/>
                            </VBox>
                        </items>
                    </SplitPane>

                    <!-- 查找替换条：默认隐藏，Ctrl+F 唤出 -->
                    <fx:include fx:id="findBar" source="find-bar.fxml"/>
                </VBox>

                <!-- 欢迎页：覆盖在所有编辑面板之上，无图书时显示，BookLoadedEvent 触发时收起 -->
                <fx:include fx:id="welcomePage" source="welcome-page.fxml"/>
            </children>
        </StackPane>
    </center>

    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" spacing="8.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="6.0" right="10.0" bottom="6.0" left="12.0"/>
            </padding>
            <Label fx:id="statusLabel" text="就绪" HBox.hgrow="ALWAYS"/>

            <!-- 进度反馈：长操作（保存/打开/校验/导入）跑时显示，跑完自动隐藏。
                 进度条 indeterminate 模式——多数长操作没有稳定进度报告。 -->
            <ProgressBar fx:id="statusProgressBar" styleClass="status-progress"
                         prefWidth="80" prefHeight="10.0" maxHeight="10.0"
                         visible="false" managed="false"/>
            <Label fx:id="statusProgressLabel" styleClass="status-progress-label"
                   visible="false" managed="false"/>
            <Region fx:id="statusProgressDivider" styleClass="status-divider" minWidth="1.0" prefWidth="1.0"
                    maxWidth="1.0" minHeight="13.0" prefHeight="13.0" maxHeight="13.0"
                    visible="false" managed="false"/>

            <!-- 右侧分区：错误 / 警告走强调色，其余走弱化色，中间用 1px 竖线隔开。
                 计数为 0 时错误 / 警告标签及其后那条竖线一并隐藏——只清标签会留下孤立竖线。 -->
            <Label fx:id="errorStatusLabel" styleClass="status-error"/>
            <Region fx:id="errorStatusDivider" styleClass="status-divider" minWidth="1.0" prefWidth="1.0"
                    maxWidth="1.0" minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <Label fx:id="warningStatusLabel" styleClass="status-warning"/>
            <Region fx:id="warningStatusDivider" styleClass="status-divider" minWidth="1.0" prefWidth="1.0"
                    maxWidth="1.0" minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <Label fx:id="chapterStatusLabel" styleClass="status-item"/>
            <Region styleClass="status-divider" minWidth="1.0" prefWidth="1.0" maxWidth="1.0"
                    minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <Label fx:id="wordStatusLabel" styleClass="status-item"/>
            <Region styleClass="status-divider" minWidth="1.0" prefWidth="1.0" maxWidth="1.0"
                    minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <!-- 当前章节字数：全书总数之外再给一个局部刻度，便于按章控制篇幅 -->
            <Label fx:id="chapterWordStatusLabel" styleClass="status-item"/>
            <Region styleClass="status-divider" minWidth="1.0" prefWidth="1.0" maxWidth="1.0"
                    minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <Label fx:id="themeStatusLabel" styleClass="status-item"/>
            <Region styleClass="status-divider" minWidth="1.0" prefWidth="1.0" maxWidth="1.0"
                    minHeight="13.0" prefHeight="13.0" maxHeight="13.0"/>
            <Label fx:id="autosaveStatusLabel" styleClass="status-item"/>
        </HBox>
    </bottom>
</BorderPane>
