<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
  「新建 EPUB 项目」对话框的内容视图。

  字段：工作空间目录 + 项目名 + 标题。
  由 controller.org.chobit.epubra.app.NewProjectDialog.show(stage, initialWorkspace)
  加载并塞进 DialogPane 的 content。OK / Cancel 按钮由 DialogPane 自带，
  FXML 不重复声明——避免破坏 Dialog 的按钮布局。
-->
<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
      spacing="14.0" prefWidth="520.0"
      fx:controller="org.chobit.epubra.app.controller.NewProjectDialogController">
    <padding>
        <Insets top="14.0" right="20.0" bottom="6.0" left="20.0"/>
    </padding>

    <!-- 顶部说明 -->
    <Label text="在选定目录下创建 MyBook/MyBook.epub + .epubra/ 项目结构"
           styleClass="muted-label" wrapText="true"/>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="80.0" prefWidth="80.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="80.0" prefWidth="80.0"/>
        </columnConstraints>

        <!-- 工作空间：路径 + 浏览 -->
        <Label text="工作空间" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="workspaceField" promptText="目录路径" GridPane.rowIndex="0"
                   GridPane.columnIndex="1" HBox.hgrow="ALWAYS"/>
        <Button fx:id="browseWorkspaceBtn" text="浏览…" styleClass="flat-button"
                onAction="#onBrowseWorkspace" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <!-- 项目名 -->
        <Label text="项目名" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="作为目录名与 EPUB 文件名"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <!-- 标题 -->
        <Label text="标题" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="留空则与项目名相同"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
    </GridPane>

    <!-- 校验失败原因 -->
    <Label fx:id="errorLabel" styleClass="dialog-error" wrapText="true"
           visible="false" managed="false"/>

    <!-- 底部小注 -->
    <Label styleClass="muted-label"
           text="项目创建后将被加入「最近的工作空间」与「最近的项目」列表"
           wrapText="true"/>
</VBox>
