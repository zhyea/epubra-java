<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
           fx:id="welcomeRoot"
           styleClass="welcome-page"
           fx:controller="org.chobit.epubra.app.controller.view.WelcomePageController">
    <VBox spacing="8.0">
        <padding>
            <Insets top="20.0" right="24.0" bottom="18.0" left="24.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="工作空间" styleClass="welcome-kicker"/>
            <Label fx:id="workspaceTitle" styleClass="welcome-workspace-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="双击图书进入编辑" styleClass="welcome-hint"/>
        </HBox>

        <Label fx:id="workspaceHint" styleClass="welcome-hint"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="book-shelf-scroll" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="bookShelf" alignment="TOP_LEFT"
                          hgap="18.0" vgap="20.0" prefWrapLength="980.0"
                          styleClass="book-shelf">
                </FlowPane>
            </content>
        </ScrollPane>
    </VBox>
</StackPane>
