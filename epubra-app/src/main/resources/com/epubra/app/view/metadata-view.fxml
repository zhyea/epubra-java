<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  元数据侧边视图：由 main-window.fxml 以 <fx:include fx:id="metadataView"/> 引入，
  控制器实例注入父控制器的 metadataViewController 字段。

  顶部「封面卡」三态：
    EMPTY     → cover-empty（虚线占位 + 选择图片）
    SET       → cover-card.thumb-side（缩略图 + 信息 + 更换/移除）
    DANGLING  → cover-card.thumb-side.cover-dangling（红底 + 清除引用）
-->
<ScrollPane xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
            styleClass="side-view" fitToWidth="true"
            visible="false" managed="false"
            maxWidth="Infinity" maxHeight="Infinity"
            fx:controller="com.epubra.app.controller.MetadataViewController">
    <VBox spacing="10.0">
        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>

        <!-- 封面卡：FXML 上三个子节点全部预创建，由 controller 在 bind() 阶段按状态显示。
             同一个 HBox 容器只展示其一；空态/异常态也提供内嵌「选择图片」按钮直达 FileChooser。
             fx:id 都以 cover 前缀统辖，便于 controller 用同一 namespace 引用。 -->
        <VBox fx:id="coverCard" styleClass="cover-card" spacing="6.0">
            <padding>
                <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
            </padding>

            <!-- 标题栏：左 "封面" 标题，右状态徽章 -->
            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <Label text="封面" styleClass="cover-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="coverStateBadge" text="未设置" styleClass="cover-state-badge"/>
            </HBox>

            <!-- 已设置：缩略图 + 文件信息 + 操作 -->
            <HBox fx:id="coverSetBox" spacing="10.0" visible="false" managed="false">
                <ImageView fx:id="coverThumb" fitWidth="84.0" fitHeight="112.0" preserveRatio="true"
                           smooth="true" styleClass="cover-thumb"/>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="coverNameLabel" text="—" styleClass="cover-name"/>
                    <Label fx:id="coverMetaLabel" text="—" styleClass="cover-meta"/>
                    <Label fx:id="coverHrefLabel" text="—" styleClass="cover-meta muted-label"/>
                </VBox>
            </HBox>
            <HBox fx:id="coverSetActions" spacing="6.0" visible="false" managed="false">
                <Button fx:id="chooseCoverButton" text="更换…" styleClass="flat-button"
                        onAction="#onPickCover"/>
                <Button fx:id="clearCoverButton" text="移除" styleClass="flat-button"
                        onAction="#onClearCover"/>
            </HBox>

            <!-- 空态：虚线占位 + 规格建议 + 选择图片入口 -->
            <VBox fx:id="coverEmptyBox" spacing="6.0" visible="false" managed="false">
                <Label text="未设置封面" styleClass="cover-empty-title"/>
                <Label text="建议使用 800×1200 以上的 PNG 或 JPEG；书籍商店通常要求 ≥ 600 最短边。"
                       wrapText="true" styleClass="panel-hint"/>
            </VBox>
            <Button fx:id="chooseCoverEmptyButton" text="选择图片…" styleClass="flat-button"
                    onAction="#onPickCover" visible="false" managed="false"/>

            <!-- 异常态：警告条 + 操作 -->
            <HBox fx:id="coverDanglingBox" spacing="10.0" visible="false" managed="false">
                <Label text="⚠ 封面引用失效" styleClass="cover-dangling-title"/>
            </HBox>
            <Label fx:id="coverDanglingDetail" styleClass="cover-dangling-detail"
                   wrapText="true" visible="false" managed="false"/>
            <HBox fx:id="coverDanglingActions" spacing="6.0" visible="false" managed="false">
                <Button fx:id="replaceCoverButton" text="重新选择…" styleClass="flat-button"
                        onAction="#onPickCover"/>
                <Button fx:id="dropCoverReferenceButton" text="清除引用" styleClass="flat-button"
                        onAction="#onClearCover"/>
            </HBox>
        </VBox>

        <Label text="元数据" styleClass="panel-title"/>
        <GridPane hgap="8.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="48.0" prefWidth="56.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/>
            </columnConstraints>

            <Label text="书名" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="作者" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="authorField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="语言" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="languageField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="出版者" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="publisherField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="标识符" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="identifierLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"
                   styleClass="muted-label" wrapText="true"/>

            <Label text="简介" GridPane.rowIndex="5" GridPane.columnIndex="0"
                   GridPane.valignment="TOP"/>
            <TextArea fx:id="descriptionArea" GridPane.rowIndex="5" GridPane.columnIndex="1"
                      prefRowCount="5" wrapText="true"/>
        </GridPane>
        <Button text="应用修改" styleClass="flat-button" onAction="#onApplyMetadata"/>
    </VBox>
</ScrollPane>
