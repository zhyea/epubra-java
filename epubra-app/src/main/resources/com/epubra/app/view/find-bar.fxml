<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<!--
  查找替换条：默认隐藏，Ctrl+F 唤出。由 main-window.fxml 以
  <fx:include fx:id="findBar"/> 引入，控制器实例注入父控制器的 findBarController 字段。
-->
<HBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
      styleClass="find-bar" spacing="6.0" alignment="CENTER_LEFT"
      visible="false" managed="false"
      fx:controller="com.epubra.app.controller.FindController">
    <padding>
        <Insets top="6.0" right="10.0" bottom="6.0" left="10.0"/>
    </padding>
    <Label text="查找"/>
    <TextField fx:id="findField" prefWidth="170.0" promptText="查找内容" onAction="#findNext"/>
    <Button text="上一个" styleClass="flat-button" onAction="#findPrevious"/>
    <Button text="下一个" styleClass="flat-button" onAction="#findNext"/>
    <Label text="替换"/>
    <TextField fx:id="replaceField" prefWidth="170.0" promptText="替换为"/>
    <Button text="替换" styleClass="flat-button" onAction="#replaceOne"/>
    <Button text="全部替换" styleClass="flat-button" onAction="#replaceAll"/>
    <CheckBox fx:id="caseSensitiveCheck" text="区分大小写" mnemonicParsing="false"/>
    <CheckBox fx:id="wholeBookCheck" text="全书范围" mnemonicParsing="false"/>
    <Label fx:id="findStatusLabel" styleClass="muted-label" HBox.hgrow="ALWAYS"/>
    <Button text="关闭" styleClass="flat-button" onAction="#closeBar"/>
</HBox>
