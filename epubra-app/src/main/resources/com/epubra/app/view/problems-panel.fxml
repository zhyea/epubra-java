<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  底部「问题」面板：默认隐藏，Ctrl+` 或「视图 → 问题面板」开关。由 main-window.fxml 以
  <fx:include fx:id="bottomPanel"/> 引入，控制器实例注入父控制器的 bottomPanelController 字段。
-->
<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml"
      styleClass="bottom-panel" VBox.vgrow="NEVER"
      visible="false" managed="false"
      fx:controller="com.epubra.app.controller.ValidationController">
    <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="10.0">
        <padding>
            <Insets top="4.0" right="10.0" bottom="4.0" left="10.0"/>
        </padding>
        <Label text="问题" styleClass="panel-header-title"/>
        <Label fx:id="problemErrorLabel" styleClass="problem-error-label"/>
        <Label fx:id="problemWarningLabel" styleClass="problem-warning-label"/>
        <Label fx:id="problemSummaryLabel" styleClass="muted-label" HBox.hgrow="ALWAYS"/>
        <Button text="重新校验" styleClass="flat-button" onAction="#run"/>
        <Button text="关闭" styleClass="flat-button" onAction="#onClosePanel"/>
    </HBox>
    <TableView fx:id="issueTable" prefHeight="170.0" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label styleClass="muted-label" text="没有问题，或尚未运行校验"/>
        </placeholder>
        <columns>
            <TableColumn text="级别" prefWidth="60.0" sortable="false">
                <cellValueFactory>
                    <PropertyValueFactory property="severity"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="分组" prefWidth="80.0" sortable="false">
                <cellValueFactory>
                    <PropertyValueFactory property="group"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="说明" prefWidth="340.0" sortable="false">
                <cellValueFactory>
                    <PropertyValueFactory property="message"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="位置" prefWidth="160.0" sortable="false">
                <cellValueFactory>
                    <PropertyValueFactory property="location"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>
